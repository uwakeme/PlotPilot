# PlotPilot（墨枢）— Anthropic 兼容 API（与官方 SDK 一致；自建网关时设 BASE_URL）
# 与 Cursor「.claude/settings.json」里同名项对齐时，请复制到系统环境或本文件，勿提交密钥。
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ── OpenAI / Gemini 官方端点（任选其一；至少配一家 LLM key）──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# 写作模型覆盖（部分辅助调用可配更快模型）
# WRITING_MODEL=

# 与 aivideo 共用方舟凭证
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=doubao-seed-2-0-mini-260215
ARK_TIMEOUT=120
ARK_REASONING_EFFORT=medium
# 代理 TLS 问题时直连
# ARK_NO_PROXY=1

# ── Embedding Service Configuration ──
# Mode: 'openai' (cloud, lightweight) or 'local' (requires ~2GB download; local 模式需另装 requirements-local.txt)
EMBEDDING_SERVICE=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Local model path (only used when EMBEDDING_SERVICE=local)
EMBEDDING_MODEL_PATH=./.models/bge-small-zh-v1.5
# GPU acceleration for local model (true/false)
EMBEDDING_USE_GPU=true

# ── Vector Store Configuration ──
VECTOR_STORE_TYPE=chromadb
# 自定义向量库目录 / Qdrant 端口（VECTOR_STORE_TYPE=qdrant 时）
# VECTOR_STORE_PATH=
# QDRANT_PORT=

# 日志配置
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/plotpilot.log
# 打印底层 HTTP 请求/响应调试日志
# DEBUG_HTTP=0

# ── Web 服务 ──
# API 启动时禁止自动拉起守护进程（独立部署守护进程时使用）
# DISABLE_AUTO_DAEMON=0
# 额外允许的跨域来源（默认已含本机与 Tauri webview origin，勿设 *）
# CORS_ORIGINS=

# ── 导出 ──
# EPUB/PDF 导出中文字体路径（系统未内嵌 CJK 字体时指定）
# PLOTPILOT_EXPORT_CJK_FONT=

# ── 桌面版（Tauri）数据目录 ──
# 生产构建下由 Rust 自动注入，指向用户可写目录（如 Windows: AppData\Roaming\com.plotpilot.desktop\data）
# 本地 CLI / 未设置时仍使用仓库内 data/
# PLOTPILOT_PROD_DATA_DIR=
# （旧名 AITEXT_PROD_DATA_DIR 仍可读，见 application/paths.py）

# 仅 Tauri 开发调试：设为 1 时即使在 debug 构建也注入生产数据目录（便于测 AppData）
# PLOTPILOT_FORCE_PROD_DATA=0

# 开发脚本/离线工具：设为 1 时允许非持久化-consumer 线程直连写 DB（绕过单写者路由）。pytest 通过 conftest 默认开启。
# PLOTPILOT_ALLOW_DIRECT_SQLITE_WRITES=0

# ── 剧情引擎写作路径（Phase 4，默认新管线）──
# 未设置或 writing / 1 / true：StoryPipeline（BaseStoryPipeline 12 步）
# full / engine：同上
# off / legacy / false：legacy 节拍写作（紧急回退）
# PLOTPILOT_USE_STORY_PIPELINE=writing

# 关闭窗口时由 Tauri 调用 POST http://127.0.0.1:<port>/internal/shutdown（仅本机回环），无需手动配置
